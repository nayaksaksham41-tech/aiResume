PORT=3000
NODE_ENV=development

# Auth (required in production for signup/login)
JWT_SECRET=use_a_long_random_string_in_production

# Optional: same value on server + in .env for `npm run test:resume` without browser login
# SCRIPT_API_KEY=

# Optional: extra admin full emails (comma-separated). Also: local part nayaksaksham41 is always admin.
# ADMIN_EMAIL=

# Use "openrouter", "groq", or "gemini"
AI_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=https://your-app.onrender.com
OPENROUTER_APP_NAME=SN Algora AI

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Puppeteer: must be true on most cloud/Linux hosts (Render, Railway, Fly, etc.)
PUPPETEER_NO_SANDBOX=true
